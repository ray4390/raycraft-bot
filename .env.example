# Create a NEW Discord application for RayCraft. Never reuse PoliBot's token.
DISCORD_TOKEN=
GUILD_ID=

# Comma-separated Discord role IDs, not names. At least one moderator role is required.
MODERATOR_ROLE_IDS=
HELPER_ROLE_IDS=

# Optional. Mod log and ticket category channels must already exist.
MOD_LOG_CHANNEL_ID=
RULES_CHANNEL_ID=
TICKET_CATEGORY_ID=

# Separate local datastore. Do not point to PoliBot's MongoDB.
DATA_FILE=./data/raycraft.json
